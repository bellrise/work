WORK_DIR = os.environ["HOME"] + "/.config/work"
REPOSITORY = "https://raw.githubusercontent.com/bellrise/work/master"

REPO_SPLIT = "<%%%>"
COMMIT_SPLIT = "<&&&>"


def unixtime():
    return int(time.time())


def _print_info(clr: str, *msgs):
    msgs = [str(x) for x in msgs]
    print(f"\033[{clr}\033[0m", *msgs)


def any_in(of, in_list):
    for item in of:
        if item in in_list:
            return True
    return False


ok = lambda *msgs: _print_info("92m*", *msgs)
warn = lambda *msgs: _print_info("93m?", *msgs)
net = lambda *msgs: _print_info("96m⤓", *msgs)


def err(*msgs):
    _print_info("91m!", *msgs)
    exit()


def read_file(path: str) -> Union[str, None]:
    # Read a file from the working directory.
    if not os.path.exists(WORK_DIR + "/" + path):
        return None
    with open(WORK_DIR + "/" + path) as f:
        return f.read()


def write_file(path: str, contents: str):
    # Create a file in the working directory.
    with open(WORK_DIR + "/" + path, "w") as f:
        f.write(contents)


def smart_autocomplete(prompt: str, strings: list[str]) -> str:
    # Smart autocomplete offers <tab> completion.

    # Terminal settings
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    new_settings = old_settings.copy()
    new_settings[3] &= ~(termios.ECHO | termios.ICANON)
    termios.tcsetattr(fd, termios.TCSANOW, new_settings)

    buffer = []
    offer = ""

    while True:
        now = "".join(buffer)

        # Guess what the user is trying to type
        offer = ""
        for string in strings:
            if string.startswith(now):
                offer = string[len(now) :]
                break

        print(f"\033[2K\r{prompt}{now}", end="", flush=True)
        if offer:
            print(f"\033[90m{offer}\033[0m\033[{len(offer)}D", end="", flush=True)

        try:
            c = sys.stdin.read(1)
        except KeyboardInterrupt:
            buffer = []
            break

        if c in ["\x7f", "\b"] and buffer:
            # Remove one char
            buffer.pop()
            continue

        if c == "\x17":
            # Remove last word
            whole = "".join(buffer).strip()
            if not whole:
                continue
            whole = whole[: -(len(whole.split()[-1]) + 1)]
            buffer = list(whole)
            continue

        if c == "\x0c":
            # Clear the page
            print("\033[2J\033[0;0H", end="", flush=True)
            continue

        # Handle escape sequences
        if c == "\x1b":
            try:
                if sys.stdin.read(3)[2] not in _string.ascii_letters:
                    sys.stdin.read(1)
            except KeyboardInterrupt:
                buffer = []
                break
            continue

        if c in ["\n", "\r"]:
            # Finish the input
            break

        if c == "\t":
            # Don't accept tabs if there is no offer to accept. Otherwise,
            # fill the buffer with the rest of the accepted chars.
            if not offer:
                continue
            buffer.extend(list(offer))
            continue

        if c in _string.printable:
            buffer.append(c)

    termios.tcsetattr(fd, termios.TCSANOW, old_settings)
    print("\r")
    return "".join(buffer)


class Timer:
    # This class handles the open timer, which can be serialized and stored
    # into a file, usually located in ~/.config/work (defined by self.wdir).
    # The timer file has a specified format for holding the start time, status,
    # any pause and/or resume time.
    #
    # This is the basic format of such a file:
    # status:start:last_pause:paused_for

    # Status of the timer. These values are presented in a human-readable form,
    # so you can read the file and know what's going on.
    STAT_STOPPED = "stopped"
    STAT_RUNNING = "running"
    STAT_PAUSED = "paused"

    # Container for storing the timer data
    timer: dict
    timer_path: str

    def __init__(self, wdir: str, repos: dict, editor=None, author=None, theme="dark") -> None:
        # Read or create the timer file if it does not exist.
        # wdir - working directory
        # editor - path to a editor, or None
        if not os.path.exists(wdir + "/timer"):
            write_file("timer", self.timer_fmt(self.STAT_STOPPED))
        raw_data = read_file("timer")
        if not raw_data or raw_data.count(":") != 3:
            raw_data = self.timer_fmt(self.STAT_STOPPED)

        stat, start, last_pause, paused_for = raw_data.split(":")

        self.wdir = wdir
        self.project = self.recognize_project()
        self.editor = editor
        self.repos = repos
        self.author = author
        self.theme = theme
        self.timer = {
            "stat": stat,
            "start": int(start),
            "last_pause": int(last_pause),
            "paused_for": int(paused_for),
        }

    @staticmethod
    def timer_fmt(stat, start_=0, last_pause=0, paused_for=0):
        # Format the parameters to create the timer string that will
        # be put in the `timer` file.
        start_, last_pause, paused_for = [
            str(x) for x in (start_, last_pause, paused_for)
        ]
        return f"{stat}:{start_}:{last_pause}:{paused_for}"

    def recognize_project(self) -> str:
        # Return the project name. If no `project` file is found,
        # result to `default`.
        p = read_file("project")
        if p:
            return p
        write_file("project", "default")
        return "default"

    def close(self):
        # Automatically save the changes to the file.
        fmt = self.timer_fmt(
            self.timer["stat"],
            self.timer["start"],
            self.timer["last_pause"],
            self.timer["paused_for"],
        )
        write_file("timer", fmt)

    def start(self):
        # Start the timer
        if self.timer["stat"] in [self.STAT_RUNNING, self.STAT_PAUSED]:
            err("Cannot start timer, already running")

        self.timer["stat"] = self.STAT_RUNNING
        self.timer["start"] = unixtime()

        ok("Started the timer")

    def edit(self):
        # Edit the session file using the user-defined editor.
        if not self.editor:
            err(
                "No editor defined in config.ini\n",
                " To fix this define the editor under [settings].",
            )
        os.system(f"{self.editor} {self.wdir}/projects/{self.project}")

    def mail(self):
        # Export the projects to a mail format.
        data = read_file("projects/" + self.project)
        if not data:
            err("Project empty")

        lines = data.strip().splitlines()
        print()

        for line in lines:
            date, hours, title = line.split(" ", 2)
            _, end_date = date.split("/", 1)
            repos = []

            if COMMIT_SPLIT in title:
                # This still needs to be here for backwards compatibility.
                # For some reason, I split BOTH the repositories and commits
                # with <&&&>. I have no idea why I did this but it doesn't
                # work.
                if REPO_SPLIT in title:
                    title, rest = title.split(REPO_SPLIT, 1)
                    repos = rest.split(REPO_SPLIT)
                else:
                    title, repos = title.split(COMMIT_SPLIT, 1)
                    repos = [repos]

            h = int(hours.split(":")[0])
            print(f"{end_date} - {h}h: {title}")

            for repo in repos:
                r = repo.split(COMMIT_SPLIT)
                repo, commits = r[0], r[1:]
                remote_addr = ""

                try:
                    remote_addr = subprocess.run(
                        ["git", "remote", "get-url", "origin"],
                        capture_output=True,
                        encoding="utf8",
                        cwd=repo,
                    ).stdout.strip()
                except Exception:
                    pass

                remote_addr = (
                    remote_addr if remote_addr else repo.rsplit("/", maxsplit=1)[-1]
                )

                print(f"    Commits in {remote_addr}:")
                for commit in commits:
                    print(f"    - {commit}")
                print()

            # Newline after every day
            print()

    def list(self, options: list):
        # List the saved sessions in the current project.
        # -o, --oneline only a single line for each session
        # -s, --sum     sum all the hours
        data = read_file("projects/" + self.project)
        if not data:
            err("Project empty")

        total_h, total_m = 0, 0

        ok(f"Sessions for the `\033[93m{self.project}\033[0m` project")
        for line in data.strip().splitlines():
            repos = []
            date, hours, title = line.split(" ", 2)
            _, end_date = date.split("/", 1)

            if COMMIT_SPLIT in title:
                # This still needs to be here for backwards compatibility.
                # For some reason, I split BOTH the repositories and commits
                # with <&&&>. I have no idea why I did this but it doesn't
                # work.
                if REPO_SPLIT in title:
                    title, rest = title.split(REPO_SPLIT, 1)
                    repos = rest.split(REPO_SPLIT)
                else:
                    title, repos = title.split(COMMIT_SPLIT, 1)
                    repos = [repos]

            h, m, _ = hours.split(":")
            if any_in(("-s", "--sum"), options):
                total_h += int(h)
                total_m += int(m)
                total_h += int((total_m - (total_m % 60)) / 60)
                total_m = total_m % 60

            # If the --oneline parameter is passed, print the minimal info
            if any_in(("-o", "--oneline"), options):
                print(f"\033[96m{hours}\033[0m - {title}")
                continue

            time_fmt = f"{int(h)} hour(s) and {int(m)} minute(s)"
            print(
                "-" * 70 + "\n"
                f"\033[92m{end_date} - \033[96m{time_fmt}\033[0m\n"
                f"  {title}"
            )

            # Sort out commits formatting
            if not repos:
                continue
            for repo in repos:
                commits = repo.split(COMMIT_SPLIT)
                name = commits[0]
                commits = commits[1:]
                print(f"  \033[35m{name}\033[0m")
                for commit in commits:
                    commit_id, msg = commit.split(" ", 1)
                    print(f"    \033[93m{commit_id}\033[0m {msg}")

        if any_in(("-s", "--sum"), options):
            print(f"\n      Sum: \033[96m{total_h} hour(s) and {total_m} minute(s)")
        if not any_in(("-o", "--oneline"), options):
            print()

    def heatmap(self):
        # Show the last 53 weeks of work across all projects, grouped by the
        # day each session ended. A regular work day (six hours or more)
        # uses the strongest shade.
        activity = {}
        data = ""
        projects_dir = os.path.join(self.wdir, "projects")
        if os.path.isdir(projects_dir):
            with os.scandir(projects_dir) as projects:
                data = "\n".join(
                    read_file("projects/" + project.name) or ""
                    for project in projects
                    if project.is_file()
                )

        for line in data.splitlines():
            parts = line.split(" ", 2)
            if len(parts) < 2:
                continue

            timestamp, duration = parts[:2]
            try:
                day = datetime.strptime(timestamp.split("/", 1)[1], "%d/%m/%y").date()
                hours, minutes, seconds = [int(value) for value in duration.split(":")]
            except (IndexError, TypeError, ValueError):
                continue

            activity[day] = activity.get(day, 0) + (
                hours * 3600 + minutes * 60 + seconds
            )

        today = Date.today()
        if self.timer["stat"] != self.STAT_STOPPED:
            activity[today] = activity.get(today, 0) + self.elapsed_seconds()

        # Align the graph to complete Sunday-Saturday columns. This yields the
        # familiar contribution-calendar shape while keeping today visible.
        sunday_index = (today.weekday() + 1) % 7
        end = today + timedelta(days=6 - sunday_index)

        terminal_width = shutil.get_terminal_size(fallback=(80, 24)).columns
        week_count = 53 if terminal_width >= 56 else max(1, terminal_width - 3)
        cell_width = 2 if terminal_width >= 3 + week_count * 2 - 1 else 1
        start = end - timedelta(days=week_count * 7 - 1)

        visible_activity = {
            day: seconds for day, seconds in activity.items()
            if start <= day <= today and seconds > 0
        }
        monthly_activity = {}
        longest_streak = streak = 0
        previous_day = None
        for day in sorted(visible_activity):
            month = day.replace(day=1)
            monthly_activity[month] = (
                monthly_activity.get(month, 0) + visible_activity[day]
            )
            streak = streak + 1 if previous_day == day - timedelta(days=1) else 1
            longest_streak = max(longest_streak, streak)
            previous_day = day

        # Yesterday's streak is still current until today ends.
        streak_day = today if today in visible_activity else today - timedelta(days=1)
        current_streak = 0
        while streak_day in visible_activity:
            current_streak += 1
            streak_day -= timedelta(days=1)

        def hours_label(seconds):
            minutes = seconds // 60
            return f"{minutes // 60}h {minutes % 60}m"

        top_month = max(monthly_activity, key=monthly_activity.get, default=None)
        top_month_label = (
            f"{top_month:%b %Y} ({hours_label(monthly_activity[top_month])})"
            if top_month else "—"
        )
        metrics = [
            (hours_label(sum(visible_activity.values())), "Total hours"),
            (top_month_label, "Top month"),
            (hours_label(max(visible_activity.values(), default=0)), "Top day hours"),
            (f"{current_streak} days", "Current streak"),
            (f"{longest_streak} days", "Longest streak"),
        ]
        # Wrap summary columns to fit the terminal; keep ANSI styling even
        # when output is piped to another program.
        print()
        while metrics:
            row = []
            row_width = 0
            while metrics:
                value, label = metrics[0]
                width = max(len(value), len(label))
                added_width = width + (3 if row else 0)
                if row and row_width + added_width > terminal_width:
                    break
                row.append((value, label, width))
                row_width += added_width
                metrics.pop(0)
            padding = " " * max(0, (terminal_width - row_width) // 2)
            print(padding + "   ".join(
                f"\033[1m{value:^{width}}\033[0m" for value, _, width in row
            ))
            print(padding + "   ".join(f"{label:^{width}}" for _, label, width in row))
            print()

        month_line = [" "] * (week_count * cell_width + 3)
        previous_month = start.month
        for week in range(week_count):
            week_start = start + timedelta(days=week * 7)
            months = [
                (week_start + timedelta(days=offset)).month for offset in range(7)
            ]
            month = next((value for value in months if value != previous_month), None)
            if month is None:
                continue

            first_day = next(
                week_start + timedelta(days=offset)
                for offset in range(7)
                if (week_start + timedelta(days=offset)).month == month
            )
            label = first_day.strftime("%b")
            position = 3 + week * cell_width
            month_line[position : position + len(label)] = label
            previous_month = month

        colors = (
            (244, 232, 193),  # F4E8C1
            (160, 193, 185),  # A0C1B9
            (112, 160, 175),  # 70A0AF
            (112, 105, 147),  # 706993
            (51, 30, 56),     # 331E38
        )
        if sys.stdout.isatty():
            color_codes = [f"38;2;{r};{g};{b}" for r, g, b in colors]
        else:
            # watch -c understands indexed colors, but not truecolor RGB.
            # Keep colors in pipes using the closest xterm palette entries.
            levels = (0, 95, 135, 175, 215, 255)
            indexed_colors = [
                (r, g, b) for r in levels for g in levels for b in levels
            ] + [(8 + 10 * i,) * 3 for i in range(24)]
            color_codes = []
            for rgb in colors:
                index = min(
                    range(len(indexed_colors)),
                    key=lambda i: sum(
                        (a - b) ** 2 for a, b in zip(rgb, indexed_colors[i])
                    ),
                ) + 16
                color_codes.append(f"38;5;{index}")
        labels = ("Su", "Mo", "Tu", "We", "Th", "Fr", "Sa")

        graph_width = 3 + week_count * cell_width - (1 if cell_width == 2 else 0)
        graph_padding = " " * max(0, (terminal_width - graph_width) // 2)
        print(graph_padding + "".join(month_line).rstrip())
        for row, label in enumerate(labels):
            cells = []
            for week in range(week_count):
                day = start + timedelta(days=week * 7 + row)
                seconds = activity.get(day, 0)
                if seconds == 0:
                    level = 0
                elif seconds < 2 * 3600:
                    level = 1
                elif seconds < 4 * 3600:
                    level = 2
                elif seconds < 6 * 3600:
                    level = 3
                else:
                    level = 4

                gap = " " if cell_width == 2 else ""
                square = "■" if cell_width == 2 else "▪"
                cells.append(f"\033[{color_codes[level]}m{square}\033[0m{gap}")

            print(graph_padding + f"{label} " + "".join(cells).rstrip())

        print()

    def cmdline_stop(self) -> str:
        # Get a title from the user on the command line.
        ok("End session of", self.elapsed_time())
        print(
            f"  In project `\033[93m{self.project}\033[0m`\n",
            " Leave empty to cancel",
        )
        try:
            title = input(": \033[96m")
        except KeyboardInterrupt:
            ok("Cancelled stop")
            return ""
        print("\033[0m", end="")
        return title

    def editor_stop(self, commit_map: dict) -> str:
        # Get a title from the user, opening the preffered editor
        # of choice.
        p = self.wdir + "/COMMIT_EDITMSG"

        # Prepare the file
        text = (
            "\n\n"
            f"# {self.elapsed_time()}\n"
            f"# On project `{self.project}`\n\n"
            "# Only the first line of this file will be counted as\n"
            "# the title. Leave it empty to cancel."
        )

        # Add the commit list
        if commit_map:
            text += "\n\n# Commits:\n"
            for repo, commits in commit_map.items():
                text += f"# {repo}\n"
                for commit in commits:
                    text += f"#   {commit}\n"

        write_file("COMMIT_EDITMSG", text)

        os.system(f"{self.editor} {p}")
        with open(p) as f:
            msg = f.readline().strip()
            if msg.startswith("#"):
                msg = ""
        os.system(f"rm -f {p}")
        return msg

    def stop(self):
        # Stop the timer
        if self.timer["stat"] == self.STAT_STOPPED:
            err("Cannot stop, timer isn't running")

        # We need to resume the timer before we stop it.
        if self.timer["stat"] == self.STAT_PAUSED:
            paused_for = unixtime() - self.timer["last_pause"]
            self.timer["last_pause"] = 0
            self.timer["paused_for"] += paused_for

        self.timer["stat"] = self.STAT_STOPPED
        elapsed_time = unixtime() - self.timer["start"] - self.timer["paused_for"]

        start_time = self.timer["start"]

        all_commits = {}
        fmt = ""

        # Add any git repositories, but only from the current project
        for repo in self.repos["default"]:
            if not os.path.isdir(repo):
                warn("Could not find repository:", repo)
                continue
            if not os.path.isdir(repo + "/.git"):
                warn(repo, "is not a git repository")
                continue

            author = f"--author='{self.author}'" if self.author else ""

            # Get the commits made during that time
            os.system(
                f"cd {repo}; git log --oneline --since={start_time} {author}"
                f"> {self.wdir}/__tmp"
            )

            # Note that this is not the best format for storing commit
            # messages, but it works. The <&&&> string splits commits
            # and the path to the repository, while <%%%> splits
            # repositories.
            commits = str(read_file("__tmp")).splitlines()
            if commits:
                all_commits[repo] = commits
                fmt += REPO_SPLIT + repo + COMMIT_SPLIT + COMMIT_SPLIT.join(commits)
            os.remove(self.wdir + "/__tmp")

        title = self.editor_stop(all_commits) if self.editor else self.cmdline_stop()
        if not title:
            err("Empty title, cannot stop")

        self.timer["start"] = 0
        self.timer["paused_for"] = 0
        self.timer["last_pause"] = 0

        m, s = divmod(elapsed_time, 60)
        h, m = divmod(m, 60)

        time_str = time.strftime("%H:%M/%d/%m/%y")
        fmt = f"{time_str} {h:02}:{m:02}:{s:02} {title}" + fmt

        # Save the session into a project file
        if not os.path.isdir(self.wdir + "/projects"):
            os.mkdir(self.wdir + "/projects")

        with open(self.wdir + "/projects/" + self.project, "a") as f:
            f.write(fmt + "\n")

        ok("Stopped the timer")

    def pause(self):
        # Pause the timer.
        if self.timer["stat"] == self.STAT_STOPPED:
            err("Cannot pause, timer isn't running")
        if self.timer["stat"] == self.STAT_PAUSED:
            warn("Already paused")

        self.timer["stat"] = self.STAT_PAUSED
        self.timer["last_pause"] = unixtime()

        ok("Paused the timer")

    def switch(self):
        # Switch to another project.
        projects = os.listdir(self.wdir + "/projects")
        print("Available projects:")
        for proj in projects:
            if proj == self.project:
                print(f"\033[93m-> {self.project}\033[0m")
            else:
                print("   " + proj)

        # Select a project
        value = smart_autocomplete("Select a project: ", projects)
        if not value or value == self.project:
            ok(f"Already in `{self.project}`")
            return

        if value not in projects:
            # Create a new project if the user types something new
            regex = r"^[A-z_][A-z0-9_]*$"
            if not re.match(regex, value):
                err(f"Invalid project name, must conform to /{regex}/")
            write_file("projects/" + value, "")

        # Switch to the given project
        write_file("project", value)
        ok(f"Switched to `{value}`")

    def resume(self):
        # Resume the timer.
        if self.timer["stat"] == self.STAT_STOPPED:
            err("Cannot resume, timer isn't running")
        if self.timer["stat"] == self.STAT_RUNNING:
            err("Already resumed")

        paused_for = unixtime() - self.timer["last_pause"]
        self.timer["last_pause"] = 0
        self.timer["paused_for"] += paused_for
        self.timer["stat"] = self.STAT_RUNNING

    def elapsed_seconds(self) -> int:
        since_start = unixtime() - self.timer["start"]
        if self.timer["stat"] == self.STAT_PAUSED:
            since_start -= unixtime() - self.timer["last_pause"]
        return since_start - self.timer["paused_for"]

    def elapsed_time(self, time_fmt=None):
        # Format the running time in a nice way. If time_fmt is passed,
        # it gets formatted with time_fmt % (h, m, s)
        elapsed = self.elapsed_seconds()

        m, s = divmod(elapsed, 60)
        h, m = divmod(m, 60)

        if not time_fmt:
            ret = f"{m} minute(s) and {s} second(s)"
            return ret if not h else f"{h} hour(s) and " + ret

        return time_fmt % (h, m, s)

    def status(self, options: list):
        # Show the status of the timer

        if any_in(("-r", "--raw"), options):
            if self.timer["stat"] == self.STAT_STOPPED:
                print("stopped 00:00:00 0")
                return
            print(
                self.timer["stat"],
                self.elapsed_time("%02d:%02d:%02d"),
                self.elapsed_seconds(),
            )
            return

        ok(f"In project `{self.project}`")
        s = self.timer["stat"]
        if s == self.STAT_PAUSED:
            ok("\033[93mPaused\033[0m, elapsed:", self.elapsed_time())
        if s == self.STAT_STOPPED:
            ok("\033[91mStopped\033[0m")
        if s == self.STAT_RUNNING:
            ok("\033[92mRunning\033[0m, elapsed:", self.elapsed_time())


